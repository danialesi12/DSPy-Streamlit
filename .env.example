# Copia questo file in .env per lo sviluppo in locale (python-dotenv lo carica
# automaticamente). Su Coolify/Render NON si usa questo file: imposti le stesse
# variabili direttamente nella dashboard del servizio ("Environment Variables").

# Un'unica chiave OpenRouter da https://openrouter.ai/keys -- da qui accedi
# a Claude, GPT, Gemini e altri senza dover gestire una chiave per provider.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Connection string del tuo Supabase self-hosted sulla stessa VPS (host
# interno "supabase-db", database/utente dedicati "promptstudio"/
# "promptstudio_user" -- vedi ISTRUZIONI.md sezione 1-2).
DATABASE_URL=postgresql+psycopg2://promptstudio_user:LA-TUA-PASSWORD@supabase-db:5432/promptstudio
