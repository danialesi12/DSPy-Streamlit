# Copia questo file in .env per lo sviluppo in locale (python-dotenv lo carica
# automaticamente). Su Coolify/Render NON si usa questo file: imposti le stesse
# variabili direttamente nella dashboard del servizio ("Environment Variables").

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Connection string di Supabase (Project Settings -> Database -> Connection
# string -> URI), con il driver +psycopg2 aggiunto dopo "postgresql".
DATABASE_URL=postgresql+psycopg2://postgres:LA-TUA-PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
