# Copia questo file in .streamlit/secrets.toml per lo sviluppo in locale.
# Su Streamlit Community Cloud, incolla lo stesso contenuto (con i valori veri)
# nella sezione Settings -> Secrets dell'app, NON committarlo mai su GitHub.

ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

[connections.promptstudio_db]
type = "sql"
# Sostituisci con la connection string di Supabase (Project Settings -> Database
# -> Connection string -> "URI"), aggiungendo il driver +psycopg2 dopo "postgresql".
url = "postgresql+psycopg2://postgres:LA-TUA-PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres"
